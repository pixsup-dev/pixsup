# Public values only — anything prefixed VITE_ ships inside the browser bundle.
# Dashboard → Project Settings → API (use the anon / publishable key).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never put the service_role / secret key here. Edge Functions receive it
# automatically on the server as SUPABASE_SERVICE_ROLE_KEY.
