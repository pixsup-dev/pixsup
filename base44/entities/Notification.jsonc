{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "hit",
        "reaction",
        "comment",
        "trending"
      ]
    },
    "post_id": {
      "type": "string"
    },
    "post_title": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "emoji": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "recipient_id",
    "type",
    "post_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}